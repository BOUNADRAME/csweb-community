# ============================================================================
# CSWeb Community Platform - Configuration Template
# ============================================================================
# Version: 2.0.0
# Date: 14 Mars 2026
# Author: Bouna DRAME
#
# IMPORTANT:
#   1. Copier ce fichier vers .env : cp .env.example .env
#   2. Modifier les valeurs selon votre environnement
#   3. Ne JAMAIS committer .env (contient mots de passe)
#
# ARCHITECTURE FLEXIBLE:
#   - Mode LOCAL: Docker containers pour DB breakout (développement/test)
#   - Mode REMOTE: Connexion serveur distant (production)
#   - Support: PostgreSQL, MySQL, SQL Server
# ============================================================================

# ============================================================================
# 🎯 CONFIGURATION BREAKOUT (ESSENTIEL - À CONFIGURER EN PREMIER)
# ============================================================================

# Mode de déploiement de la base de données breakout
# local  = Docker containers (développement, test)
# remote = Serveur distant (production, RGPH5, etc.)
BREAKOUT_MODE=local

# Type de base de données pour le breakout
# postgresql = PostgreSQL (recommandé pour analytics)
# mysql      = MySQL (compatible, performant)
# sqlserver  = SQL Server (RGPH5 Sénégal, production enterprise)
BREAKOUT_DB_TYPE=postgresql

# ============================================================================
# 📦 APPLICATION
# ============================================================================
APP_ENV=prod
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_SECRET=

# Ports
CSWEB_PORT=8080

# ============================================================================
# 🗄️ MySQL - Métadonnées CSWeb (TOUJOURS LOCAL - NE PAS MODIFIER)
# ============================================================================
# Cette base de données est créée automatiquement par setup.php
# Elle contient les métadonnées CSWeb (users, dictionaries, oauth_clients)
# ⚠️ TOUJOURS sur la même machine que CSWeb (localhost ou container 'mysql')
# ⚠️ NE JAMAIS utiliser cette base pour le breakout !

MYSQL_HOST=mysql
# Port INTERNE (app -> mysql via réseau Docker). Laisser à 3306.
MYSQL_PORT=3306
# Port HÔTE (accès externe optionnel). Changer (ex. 3316) si un mysqld natif
# occupe déjà 3306 sur le serveur. N'affecte PAS la connexion interne.
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=csweb_metadata
MYSQL_USER=csweb_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ============================================================================
# 🐘 PostgreSQL - Breakout (si BREAKOUT_DB_TYPE=postgresql)
# ============================================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=csweb_analytics
POSTGRES_USER=csweb_analytics
POSTGRES_PASSWORD=

# ============================================================================
# 🐬 MySQL - Breakout (si BREAKOUT_DB_TYPE=mysql)
# ============================================================================

MYSQL_BREAKOUT_HOST=mysql-breakout
MYSQL_BREAKOUT_PORT=3307
MYSQL_BREAKOUT_DATABASE=csweb_breakout
MYSQL_BREAKOUT_USER=breakout_user
MYSQL_BREAKOUT_PASSWORD=

# ============================================================================
# 🏢 SQL Server - Breakout (si BREAKOUT_DB_TYPE=sqlserver)
# ============================================================================

SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=CSWeb_Analytics
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrong!Passw0rd

# ============================================================================
# 🛠️ OUTILS DE DÉVELOPPEMENT (Optionnel)
# ============================================================================

PHPMYADMIN_PORT=8081
PGADMIN_PORT=8082
PGADMIN_EMAIL=admin@csweb.local
PGADMIN_PASSWORD=admin123

# ============================================================================
# 🔐 SÉCURITÉ
# ============================================================================

JWT_SECRET=
JWT_EXPIRATION=86400000
FILES_FOLDER=/var/www/html/files
# URL PUBLIQUE de l'API — celle que reçoivent les clients CSPro.
#
# Elle est écrite dans la spec de synchronisation (SyncService=) et dans les
# liens cspro:/// de l'écran Data. Les tablettes et postes de travail s'y
# connectent : elle doit donc porter une adresse qu'ILS peuvent joindre, avec
# le port publié s'il y en a un.
#   VPS / domaine : https://csweb.example.org/api/
#   IP + port     : http://203.0.113.10:8095/api/
#
# Laisser VIDE de préférence : le setup la déduit de la requête du navigateur,
# qui porte déjà le bon domaine ET le bon port. À ne renseigner que si CSWeb
# est derrière un reverse proxy qui change l'adresse vue par le navigateur.
API_URL=

# Adresse INTERNE que CSWeb utilise pour appeler sa propre API (HttpHelper,
# vérification du setup). Résolue DEPUIS LE CONTENEUR, où Apache écoute sur 80
# et où le port publié n'existe pas — d'où l'absence de port ici.
# À ne changer que si Apache n'écoute pas sur 80 dans le conteneur.
CSWEB_INTERNAL_API_URL=http://localhost/api/

# ============================================================================
# 📊 LOGGING
# ============================================================================
CSWEB_LOG_LEVEL=error
CSWEB_PROCESS_CASES_LOG_LEVEL=error
MAX_EXECUTION_TIME=300

# ============================================================================
# ⚡ PERFORMANCE TUNING
# ============================================================================
#
# ⚠️  APPLIQUER UN CHANGEMENT : `docker compose up -d`, JAMAIS `restart`.
#
#     docker compose restart csweb mysql   ❌ ne prend PAS en compte ce fichier
#     docker compose up -d csweb mysql     ✅ recrée les conteneurs, valeurs appliquées
#
#     `restart` redémarre le processus dans le conteneur existant, qui conserve
#     les variables de sa création. Aucun message d'erreur : on croit avoir
#     augmenté la mémoire alors que rien n'a changé.
#
#     Vérifier après coup :  php bin/console csweb:check-config
#     (compare les valeurs réellement actives à celles de ce fichier)
#
# --- Valeurs de référence selon le déploiement ---
#
#   Poste de développement       Production (RGPH, grande enquête)
#   ────────────────────────     ─────────────────────────────────────────────
#   PHP_MEMORY_LIMIT=512M        512M à 1G (le breakout charge un lot en mémoire)
#   MYSQL_INNODB_BUFFER_POOL     256M → 60-70 % de la RAM du serveur
#   MYSQL_MAX_CONNECTIONS=200    ≥ APACHE_MAX_REQUEST_WORKERS + marge
#   APACHE_MAX_REQUEST_WORKERS   150 → selon le pic de synchronisations
#
#   Le buffer pool InnoDB est le réglage le plus déterminant : en dessous de la
#   taille des données actives, MySQL lit sur disque et tout s'effondre, quels
#   que soient les autres paramètres. Sur un serveur de 16 Go dédié à CSWeb,
#   viser 10-11G.
#
#   MYSQL_MAX_CONNECTIONS doit rester supérieur à APACHE_MAX_REQUEST_WORKERS :
#   chaque worker Apache peut ouvrir une connexion, et le breakout comme
#   l'ordonnanceur en consomment en plus.
#
#   Le pic de charge d'un recensement, ce n'est pas le breakout — qui tourne en
#   arrière-plan — mais la synchronisation : les enquêteurs collectent hors
#   ligne toute la journée et se synchronisent en fin de journée, souvent tous
#   dans la même heure. Dimensionner Apache et MySQL pour ce pic.

# --- PHP ---
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_TIME=300
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_POST_MAX_SIZE=100M
PHP_SESSION_GC_MAXLIFETIME=7200
PHP_OPCACHE_MEMORY=128
PHP_OPCACHE_MAX_FILES=10000

# --- MySQL Metadata ---
MYSQL_MAX_CONNECTIONS=200
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_INNODB_LOG_FILE_SIZE=64M
MYSQL_SLOW_QUERY_TIME=2
MYSQL_MAX_ALLOWED_PACKET=64M
MYSQL_THREAD_CACHE_SIZE=16
MYSQL_TABLE_OPEN_CACHE=2000
MYSQL_WAIT_TIMEOUT=28800

# --- PostgreSQL Breakout ---
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB

# --- Apache MPM Prefork ---
APACHE_MAX_REQUEST_WORKERS=150
APACHE_SERVER_LIMIT=150
APACHE_KEEP_ALIVE_TIMEOUT=5
APACHE_MAX_KEEP_ALIVE_REQUESTS=100
APACHE_TIMEOUT=300

# ============================================================================
# 🔐 WEBHOOKS (sécurité)
# ============================================================================
# Secret partagé pour authentifier les appels aux webhooks racine :
#   - breakout-webhook.php          (déclenche un breakout)
#   - breakout-status-webhook.php   (status par dictionnaire)
#   - dictionary-schema-webhook.php (CRUD config breakout)
#   - log-reader-webhook.php        (lecture des logs)
#
# OBLIGATOIRE : sans cette variable, les webhooks renvoient 500.
# Générer une valeur forte (32+ octets aléatoires) :
#   openssl rand -hex 32
BREAKOUT_WEBHOOK_TOKEN=

# ============================================================================
# 🔌 BREAKOUT TARGET CONNECTION MODE
# ============================================================================
# Le breakout pousse les données collectées vers une base SGBD cible
# (PostgreSQL / MySQL / SQL Server). Selon votre infrastructure, CSWeb peut
# se connecter de 2 manières :
#
#   direct  — CSWeb appelle directement host:port renseigné dans le formulaire.
#             Convient si :
#               • DB co-localisée (CSWeb et DB sur la même machine ou VPC)
#               • DB Docker locale via le profil local-mysql / local-postgres
#               • DB exposée publiquement (avec whitelist IP recommandée)
#               • Réseau privé (10.x, 192.168.x) accessible directement
#
#   tunnel  — CSWeb monte un tunnel SSH vers BREAKOUT_SSH_HOST puis se
#             connecte sur 127.0.0.1:BREAKOUT_TUNNEL_LOCAL_PORT. Convient si :
#               • La DB n'est PAS exposée publiquement (port DB fermé)
#               • Vous accédez normalement à la DB via tunnel SSH
#                 (ex: comme DBeaver avec une clé privée)
#
# En mode tunnel, le formulaire "Add Configuration" continue d'accepter
# n'importe quel host_name (cosmétique) — CSWeb le réécrit à 127.0.0.1
# au moment de la connexion réelle.
# ============================================================================
BREAKOUT_CONNECTION_MODE=direct

# --- Tunnel SSH (uniquement si BREAKOUT_CONNECTION_MODE=tunnel) ---
# Cible SSH (le serveur où la DB tourne)
BREAKOUT_SSH_HOST=
BREAKOUT_SSH_PORT=22
BREAKOUT_SSH_USER=

# Chemin de la clé privée SSH SUR L'HÔTE (sera bind-mountée dans le container).
# Exemple sur macOS : /Users/votre-user/.ssh/id_breakout
# Doit être lisible par le user qui lance docker (chmod 600).
BREAKOUT_SSH_KEY_PATH_HOST=

# Optionnel : passphrase si la clé est chiffrée (déconseillé pour automatisation,
# préférez une clé dédiée sans passphrase).
BREAKOUT_SSH_KEY_PASSPHRASE=

# Forwarding du tunnel
# Local      : port d'écoute À L'INTÉRIEUR du container CSWeb (libre, défaut 13306)
# Remote host: vu DEPUIS LE SERVEUR SSH (généralement 127.0.0.1 si la DB
#              tourne sur la même machine que le SSH).
# Remote port: port natif de la DB cible. À adapter selon BREAKOUT_DB_TYPE :
#   • MySQL      → 3306
#   • PostgreSQL → 5432
#   • SQL Server → 1433
BREAKOUT_TUNNEL_LOCAL_PORT=13306
BREAKOUT_TUNNEL_REMOTE_HOST=127.0.0.1
BREAKOUT_TUNNEL_REMOTE_PORT=3306

# Keepalive SSH (en secondes) — détecte les coupures pour relancer le tunnel
BREAKOUT_TUNNEL_KEEPALIVE=30
